<view class="page">
  <view class="eyebrow">A-Level 学习计划</view>
  <view class="title">今天</view>

  <view class="hero card">
    <view>
      <view class="muted small">下一场考试</view>
      <view class="hero-title">{{nextExam.examTitle}}</view>
      <view class="muted small">{{today}} · {{weekday}}</view>
    </view>
    <view class="countdown">
      <view class="count-number">{{nextExam.examDaysLeft}}</view>
      <view class="small">天</view>
    </view>
  </view>

  <view class="stats">
    <view class="stat card">
      <view class="stat-value">{{todayTasks.length}}</view>
      <view class="muted small">今日任务</view>
    </view>
    <view class="stat card">
      <view class="stat-value">{{todayClasses.length}}</view>
      <view class="muted small">今日课程</view>
    </view>
    <view class="stat card">
      <view class="stat-value">{{subjects.length}}</view>
      <view class="muted small">备考科目</view>
    </view>
  </view>

  <view class="section-title">
    <text>今日任务</text>
    <text class="muted">{{todayTasks.length}} 条</text>
  </view>
  <block wx:for="{{todayTasks}}" wx:key="id">
    <button class="task card" bindtap="toggleTask" data-id="{{item.id}}">
      <view class="check {{item.completedClass}}">{{item.completedMark}}</view>
      <view class="task-body">
        <view class="task-title">{{item.title}}</view>
        <view class="muted small">{{item.startTime}} - {{item.endTime}} · {{item.priority}}</view>
      </view>
    </button>
  </block>
  <view wx:if="{{!hasTodayTasks}}" class="empty">今天还没有任务。</view>

  <view class="section-title">
    <text>今日课表</text>
    <text class="muted">{{weekday}}</text>
  </view>
  <block wx:for="{{todayClasses}}" wx:key="id">
    <view class="class-card card">
      <view class="color-dot" style="background: {{item.color}};"></view>
      <view>
        <view class="task-title">{{item.title}}</view>
        <view class="muted small">{{item.startTime}} - {{item.endTime}} · {{item.room}}</view>
      </view>
    </view>
  </block>
  <view wx:if="{{!hasTodayClasses}}" class="empty">今天没有课程安排。</view>
</view>
