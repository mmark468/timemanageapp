.tabs {
  width: 100%;
  margin-top: 28rpx;
  white-space: nowrap;
}

.tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 108rpx;
  height: 64rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #6b7280;
  font-size: 26rpx;
  font-weight: 900;
}

.tab.active {
  background: #111827;
  color: #ffffff;
}

.course {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
  padding: 26rpx;
}

.time {
  width: 128rpx;
}

.time-main,
.course-title {
  font-size: 30rpx;
  font-weight: 900;
}

.course-body {
  flex: 1;
}

.course-color {
  width: 22rpx;
  height: 76rpx;
  border-radius: 999rpx;
}

.small {
  font-size: 24rpx;
  font-weight: 800;
}
