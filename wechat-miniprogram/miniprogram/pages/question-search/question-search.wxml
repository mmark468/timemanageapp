<view class="page">
  <view class="eyebrow">CAIE Mathematics 9709</view>
  <view class="title">数学搜题</view>

  <view class="database card">
    <view>
      <view class="muted small">本地题库</view>
      <view class="database-title">{{databaseStats.questionCount}} 个种子题目 · {{databaseStats.componentCount}} 个组件</view>
      <view class="muted small">上传图片后可结合文件名、Paper、题号和关键词匹配。</view>
    </view>
  </view>

  <view class="upload card">
    <button class="upload-button" bindtap="chooseQuestionImage">
      <image wx:if="{{uploadedImagePath}}" src="{{uploadedImagePath}}" mode="aspectFill" class="preview"></image>
      <view wx:else class="upload-empty">
        <view class="upload-icon">＋</view>
        <view class="upload-title">拍照 / 上传题目</view>
        <view class="muted small">建议保留 9709、Paper、题号或页眉</view>
      </view>
    </button>
    <button wx:if="{{uploadedImagePath}}" class="clear-button" bindtap="clearImage">清除图片</button>
  </view>

  <view class="search card">
    <input class="search-input" value="{{query}}" bindinput="onInputQuery" placeholder="9709/11/M/J/24 Q3、topic、关键词" />
  </view>

  <scroll-view class="filters" scroll-x>
    <block wx:for="{{componentFilters}}" wx:key="id">
      <button class="filter {{item.activeClass}}" bindtap="selectComponent" data-id="{{item.id}}">
        {{item.label}}
      </button>
    </block>
  </scroll-view>

  <view class="recognition card">
    <view class="recognition-line">
      <text class="muted small">文本线索</text>
      <text class="line-value">{{signalSummary}}</text>
    </view>
    <view class="recognition-line">
      <text class="muted small">试卷定位</text>
      <text class="line-value">{{paperSummary}}</text>
    </view>
  </view>

  <view class="section-title">
    <text>相似题匹配</text>
    <text class="muted">{{results.length}} 条</text>
  </view>

  <block wx:for="{{results}}" wx:key="id">
    <view class="result card">
      <view class="result-head">
        <view>
          <view class="muted small">{{item.paper}}</view>
          <view class="result-title">{{item.ref}} · {{item.title}}</view>
        </view>
        <view class="score">{{item.score}}%</view>
      </view>

      <view class="question soft-card">
        <view class="question-number">{{item.ref}}</view>
        <view class="question-summary">{{item.questionSummary}}</view>
      </view>

      <view class="scheme soft-card">
        <view class="muted small">Mark scheme</view>
        <view class="scheme-text">{{item.markSchemeSummary}}</view>
      </view>

      <view class="actions">
        <button class="action dark" bindtap="copyLink" data-url="{{item.questionPdf}}">复制题目 PDF</button>
        <button class="action" bindtap="copyLink" data-url="{{item.markSchemePdf}}">复制 Mark Scheme</button>
      </view>

      <view class="reasons">
        <text class="tag">{{item.topic}}</text>
        <text class="tag">{{item.reasonText}}</text>
      </view>
    </view>
  </block>

  <view wx:if="{{showEmpty}}" class="empty">暂时没搜到，试试输入 Paper / 题号 / 知识点。</view>
</view>
