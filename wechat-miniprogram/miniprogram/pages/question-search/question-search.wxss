.database,
.upload,
.search,
.recognition {
  margin-top: 24rpx;
  padding: 28rpx;
}

.database-title {
  margin: 8rpx 0;
  font-size: 32rpx;
  font-weight: 900;
}

.small {
  font-size: 24rpx;
  font-weight: 800;
}

.upload-button {
  width: 100%;
  min-height: 260rpx;
  overflow: hidden;
  border: 4rpx dashed rgba(17, 24, 39, 0.12);
  border-radius: 28rpx;
  background: #f6f8fb;
}

.preview {
  width: 100%;
  height: 260rpx;
  border-radius: 24rpx;
}

.upload-empty {
  display: flex;
  min-height: 260rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.upload-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #111827;
  color: #ffffff;
  font-size: 52rpx;
  font-weight: 500;
}

.upload-title {
  margin-top: 20rpx;
  font-size: 32rpx;
  font-weight: 900;
}

.clear-button {
  width: 100%;
  height: 64rpx;
  margin-top: 16rpx;
  border-radius: 999rpx;
  background: #eef2f7;
  color: #6b7280;
  font-size: 24rpx;
  font-weight: 900;
}

.search-input {
  height: 76rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.filters {
  width: 100%;
  margin-top: 22rpx;
  white-space: nowrap;
}

.filter {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 116rpx;
  height: 62rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #6b7280;
  font-size: 26rpx;
  font-weight: 900;
}

.filter.active {
  background: #111827;
  color: #ffffff;
}

.recognition-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 58rpx;
}

.line-value {
  max-width: 430rpx;
  overflow: hidden;
  color: #111827;
  font-size: 24rpx;
  font-weight: 900;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result {
  margin-bottom: 20rpx;
  padding: 28rpx;
}

.result-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.result-title {
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.4;
}

.score {
  min-width: 86rpx;
  padding: 14rpx 0;
  border-radius: 999rpx;
  background: #111827;
  color: #ffffff;
  text-align: center;
  font-size: 24rpx;
  font-weight: 900;
}

.question,
.scheme {
  margin-top: 18rpx;
  padding: 22rpx;
}

.question-number {
  margin-bottom: 10rpx;
  font-size: 26rpx;
  font-weight: 900;
}

.question-summary,
.scheme-text {
  color: #111827;
  font-size: 26rpx;
  font-weight: 750;
  line-height: 1.55;
}

.actions,
.reasons {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.action,
.tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #f6f8fb;
  color: #111827;
  font-size: 24rpx;
  font-weight: 900;
}

.action.dark {
  background: #111827;
  color: #ffffff;
}
